# Cloudflare Pages header rules.
# /pandapdf-online/ is the PandaPDF web build: its .wasm and .js names carry a content hash,
# so they can be cached forever; index.html must be revalidated to pick up new builds.
/*
  X-Content-Type-Options: nosniff

/pandapdf-online/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# The app's wasm ships gzip-compressed (Cloudflare Pages' 25 MiB file limit) and index.html
# decompresses it in the browser.
/pandapdf-online/*.wasm.gz
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/pandapdf-online/*.js
  Cache-Control: public, max-age=31536000, immutable

/pandapdf-online/
  Cache-Control: no-cache

/pandapdf-online/index.html
  Cache-Control: no-cache
